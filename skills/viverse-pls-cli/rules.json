{
  "rules": [
    {
      "id": "pls-cli-no-inline-credentials",
      "profiles": ["upload", "replace"],
      "phases": ["upload", "replace", "verify", "fix"],
      "type": "forbidden_any",
      "pattern": "--email=['\"]?[^$\\s]{1,}['\"]?|--password=['\"]?[^$\\s]{1,}['\"]?",
      "message": "Never pass credentials as literal values in shell commands — use env vars ($PLS_CLI_TEST_EMAIL, $PLS_CLI_TEST_PASSWORD).",
      "severity": "high"
    },
    {
      "id": "pls-cli-env-vars-sourced",
      "profiles": ["upload", "replace"],
      "phases": ["upload", "replace"],
      "type": "required_any",
      "pattern": "source .env|\\$PLS_CLI_TEST_EMAIL|\\$PLS_CLI_TEST_PASSWORD|\\$VIVERSE_TEST_EMAIL|\\$VIVERSE_TEST_PASSWORD",
      "message": "Credentials must be loaded from env vars before running pls-cli commands (PLS_CLI_TEST_* or VIVERSE_TEST_* aliases).",
      "severity": "high"
    },
    {
      "id": "pls-cli-json-flag-for-agents",
      "profiles": ["upload", "replace"],
      "phases": ["upload", "replace"],
      "type": "required_any",
      "pattern": "--json",
      "message": "Always pass --json when parsing upload/replace output programmatically. Parse the trailing JSON object; upload progress bars may precede it on stdout.",
      "severity": "medium"
    },
    {
      "id": "pls-cli-list-json-requires-group",
      "profiles": ["upload", "replace", "list"],
      "phases": ["list", "verify"],
      "type": "forbidden_any",
      "pattern": "pls-cli list --json(?!.*--group)|pls-cli list --json$",
      "message": "pls-cli list --json requires --group; without it stdout can be empty.",
      "severity": "medium"
    }
  ]
}
